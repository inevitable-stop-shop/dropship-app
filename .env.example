# ============================================================
#  Shopify Custom App Configuration
#  Copy this file to ".env" and fill in your values.
#  See GUIDE.md for step-by-step instructions.
# ============================================================

# Your Shopify store domain (e.g. mystore.myshopify.com — no https://)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API access token (from Custom App > API credentials)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API key and secret (from the same page)
SHOPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL where this app is reachable (for webhooks).
#   Local dev:  use ngrok (https://ngrok.com) → APP_BASE_URL=https://abc123.ngrok.app
#   Production: your deployed URL with HTTPS
APP_BASE_URL=https://your-ngrok-or-domain.app

# Port the app runs on
PORT=3000

# SMTP settings for emailing suppliers when orders come in.
# Gmail example (use an App Password, not your real password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Email that supplier fulfillment notifications are sent from
MAIL_FROM="Nova Fulfillment <you@gmail.com>"

# App admin panel password (change this!)
APP_ADMIN_PASSWORD=admin123