<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Dropship App</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <% if (locals.authed) { %>
  <nav class="sidebar">
    <div class="sidebar-header">
      <h2>Dropship</h2>
      <span class="badge">Shopify App</span>
    </div>
    <a href="/" class="<%= activeNav === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/suppliers" class="<%= activeNav === 'suppliers' ? 'active' : '' %>">Suppliers</a>
    <a href="/products" class="<%= activeNav === 'products' ? 'active' : '' %>">Products</a>
    <a href="/orders" class="<%= activeNav === 'orders' ? 'active' : '' %>">Fulfillment</a>
    <a href="/settings" class="<%= activeNav === 'settings' ? 'active' : '' %>">Settings</a>
    <div class="sidebar-footer">
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <% } %>
  <main class="<%= !locals.authed ? 'full' : '' %>">
    <%- body %>
  </main>
</body>
</html>