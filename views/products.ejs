<div class="page-header">
  <h1>Products</h1>
  <button class="btn primary" onclick="document.getElementById('add-product').style.display='block'">+ Add Product</button>
</div>

<% if (locals.error) { %><div class="alert error"><%= error %></div><% } %>

<div id="add-product" class="card" style="display:none">
  <h3>New Product</h3>
  <form method="POST" action="/products">
    <div class="form-grid">
      <label class="full">Title<input type="text" name="title" required></label>
      <label class="full">Description<textarea name="description" rows="3"></textarea></label>
      <label>Sell Price ($)<input type="number" step="0.01" name="price" required></label>
      <label>Supplier Cost ($)<input type="number" step="0.01" name="cost"></label>
      <label>SKU<input type="text" name="sku"></label>
      <label>Inventory Qty<input type="number" name="inventory" value="0"></label>
      <label class="full">Image URL<input type="url" name="image_url" placeholder="https://..."></label>
      <label>Supplier
        <select name="supplier_id" required>
          <% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </label>
      <label class="checkbox-row">
        <input type="checkbox" name="push_to_shopify" checked>
        Push to Shopify immediately
      </label>
    </div>
    <button type="submit" class="btn primary">Save Product</button>
  </form>
</div>

<div class="card">
  <% if (products.length === 0) { %>
    <p class="muted">No products yet. Add your first product above.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Title</th><th>Supplier</th><th>Price</th><th>Cost</th><th>Margin</th><th>SKU</th><th>Shopify</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
        <tr>
          <td><strong><%= p.title %></strong></td>
          <td><%= p.supplier_name %></td>
          <td>$<%= p.price.toFixed(2) %></td>
          <td>$<%= p.cost.toFixed(2) %></td>
          <td><% const margin = p.price - p.cost; %>$<%= margin.toFixed(2) %> (<%= p.cost > 0 ? ((margin/p.price)*100).toFixed(0) : '—' %>%)</td>
          <td><%= p.sku || '—' %></td>
          <td>
            <% if (p.shopify_product_id) { %>
              <span class="pill synced">Synced</span>
            <% } else { %>
              <span class="pill unfulfilled">Not pushed</span>
            <% } %>
          </td>
          <td class="action-group">
            <form method="POST" action="/products/<%= p.id %>/push" style="display:inline">
              <button class="btn small" title="Push/sync to Shopify">Sync</button>
            </form>
            <form method="POST" action="/products/<%= p.id %>/delete" style="display:inline"
                  onsubmit="return confirm('Delete product and remove from Shopify?')">
              <button class="btn danger small">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>